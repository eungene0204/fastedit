# OpenRouter API 키 (없으면 규칙 기반 교정만 동작)
OPENROUTER_API_KEY=

# 모델·한도·타임아웃은 config/models.yaml 에서 바꾼다. 아래는 그 파일 값을 덮어쓰는 선택 항목이다.
# deny: 학습·보관하지 않는 모델(dataPolicy: no-train)만 사용 / allow: 학습 허용 호스트도 사용
# 기본 모델(nvidia/nemotron-3.5-super-vl:free)은 학습 허용 호스트만 있어 allow가 필요하다
FASTEDIT_DATA_COLLECTION=allow
# 1이면 무료 모델이 실패·소진될 때 유료 모델(tier: paid)로 넘어간다 (비용 발생)
# FASTEDIT_ALLOW_PAID=0

# 여러 서버 인스턴스가 캐시·한도 카운터를 공유하려면 Redis. 없으면 인메모리
# REDIS_URL=redis://127.0.0.1:6379
# 캐시 암호화 키(임의의 긴 문자열). 없으면 프로세스마다 임시 키를 만들어 재시작 시 캐시가 비워진다
# CACHE_ENCRYPTION_KEY=

PORT=8787
